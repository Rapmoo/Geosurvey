{
  "name": "geosurvey-file-storage-api",
  "version": "1.0.0",
  "description": "Company-owned file storage backend for GeoSurvey. Verifies Firebase ID tokens on every request and stores uploaded photos/audio outside of Firebase Storage, on infrastructure the company controls.",
  "main": "Backend/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node Backend/server.js",
    "dev": "node --watch Backend/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "build": "node scripts/build.js"
  },
  "dependencies": {
    "check-disk-space": "^3.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "file-type": "^16.5.4",
    "firebase-admin": "^12.3.1",
    "firebase-functions": "^6.0.1",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18"
  }
}
